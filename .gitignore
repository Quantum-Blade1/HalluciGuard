# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
.venv/
venv/
env/

# Environment
.env

# Data (generated at runtime — never commit)
data/bloom/*.json
data/chroma_store/
data/cve_cache/
data/audit_log.jsonl

# Scanner pycache (root scanner/ and vscode-extension/scanner/)
scanner/__pycache__/
scanner/**/__pycache__/
vscode-extension/scanner/__pycache__/
vscode-extension/scanner/**/__pycache__/

# Generated data inside vscode-extension (runtime artifacts)
vscode-extension/data/chroma_store/
vscode-extension/data/cve_cache/
vscode-extension/data/audit_log.jsonl

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (vscode-extension)
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix
